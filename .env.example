# Copy to .env for local runs. In GitHub Actions these come from repository secrets.

# Raises GitHub API limits from 60/h to 5000/h (a classic token with no scopes is enough).
GITHUB_TOKEN=

# Enables the Claude analysis layer (summaries, gaps, build ideas). Leave empty to skip.
ANTHROPIC_API_KEY=
# TRENDFORGE_AI=auto            # auto | on | off
# TRENDFORGE_AI_MODEL=claude-opus-5-5
# TRENDFORGE_AI_MAX_REPOS=30    # new repos analyzed per run (insights are cached 30 days)
# TRENDFORGE_AI_MAX_CATEGORIES=8

# Optional: camofox-browser for sites that block plain HTTP (e.g. Reddit).
# Start it from the camofox-browser repo with `npm start`.
CAMOFOX_URL=http://localhost:9377
CAMOFOX_API_KEY=

# TRENDFORGE_REDDIT=1
# TRENDFORGE_HN=1
