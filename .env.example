# Copy to .env for local runs. In GitHub Actions these come from repository secrets.

# Raises GitHub API limits from 60/h to 5000/h (a classic token with no scopes is enough).
GITHUB_TOKEN=

# Claude analysis layer (summaries, gaps, build ideas).
# Default: uses YOUR Claude account through the Claude Code CLI (`claude -p`) - no API key needed.
# It finds `claude` on PATH or the copy bundled with the VS Code extension; override with CLAUDE_CLI.
# TRENDFORGE_AI=auto              # auto | on | off
# TRENDFORGE_AI_BACKEND=auto      # auto (CLI first, then API key) | cli | api
# CLAUDE_CLI=C:\path\to\claude.exe
# TRENDFORGE_AI_MODEL=            # empty = Claude Code's default; e.g. sonnet or haiku to use less of your plan
# TRENDFORGE_AI_EFFORT=low
# TRENDFORGE_AI_INTERVAL_DAYS=7   # AI runs weekly; data still updates daily. 1 = AI every day
# TRENDFORGE_AI_MAX_REPOS=50      # new repos analyzed per AI run (insights cached 60 days)
# TRENDFORGE_AI_MAX_CATEGORIES=8
# Only needed for the API backend (e.g. the GitHub Actions backup run):
ANTHROPIC_API_KEY=

# Optional: camofox-browser for sites that block plain HTTP (e.g. Reddit).
# Start it from the camofox-browser repo with `npm start`.
CAMOFOX_URL=http://localhost:9377
CAMOFOX_API_KEY=

# TRENDFORGE_REDDIT=1
# TRENDFORGE_HN=1
